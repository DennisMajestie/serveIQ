{
  "installCommand": "npm install",
  "buildCommand": "npx nx build waiter --configuration=production",
  "outputDirectory": "../../dist/apps/waiter/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://serveiq-backend-1.onrender.com/api/v1/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ]
}
