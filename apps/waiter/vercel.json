{
  "installCommand": "npm install",
  "buildCommand": "npx nx build waiter --configuration=production",
  "outputDirectory": "../../dist/apps/waiter/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://serveiq-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
