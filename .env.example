# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Paystack Configuration
# WARNING: Replace sk_test_REPLACE_ME and pk_test_REPLACE_ME with production keys before going live.
# Paystack test keys are NOT valid for real transactions.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME

# Nemotron/LLM Configuration
NEMOTRON_API_KEY=your-nemotron-api-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=meta/llama-3.1-70b-instruct

# Sentry Error Monitoring (optional — skip if not set)
SENTRY_DSN=https://key@oXXXX.ingest.us.sentry.io/XXXXX

# Frontend Sentry (Vite env var — loaded by Angular build)
VITE_SENTRY_DSN=https://key@oXXXX.ingest.us.sentry.io/XXXXX
