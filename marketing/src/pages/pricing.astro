---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const canonical = 'https://serveiq.io/pricing';
const description = 'ServeIQ pricing — transparent plans for restaurants, bars and hotels. No hidden fees, no per-terminal charges. Start free, upgrade when you are ready.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Pricing',
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'ServeIQ', url: 'https://serveiq.io' },
};

const plans = [
  {
    name: 'Starter',
    price: '[PLACEHOLDER]',
    period: '/month',
    description: 'For small cafés and single-location restaurants getting started with digital POS.',
    features: [
      '1 branch, 3 user accounts',
      'Table QR menu',
      'Cash & card settlement',
      'Basic order management',
      'Email support',
    ],
    cta: 'Get Started',
    ctaHref: 'https://app.serveiq.io/register',
    highlighted: false,
  },
  {
    name: 'Growth',
    price: '[PLACEHOLDER]',
    period: '/month',
    description: 'For growing restaurants that need split payments, kitchen routing and offline reliability.',
    features: [
      'Up to 5 branches, 15 user accounts',
      'Per-guest split payments (item / amount / percent)',
      'Offline mode with auto-sync',
      'Kitchen display routing by department',
      'Paystack + transfer + USSD integration',
      'Stock & ingredient tracking',
      'Priority support',
    ],
    cta: 'Start Free Trial',
    ctaHref: 'https://app.serveiq.io/register',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: '[PLACEHOLDER]',
    period: '/month',
    description: 'For multi-branch chains and hotel F&B operations requiring full control and audit trails.',
    features: [
      'Unlimited branches & users',
      'Custom role-based access control',
      'Real-time multi-branch dashboard',
      'Audit logs & advanced reporting',
      'API access & custom integrations',
      'Dedicated account manager',
      'SLA & onboarding support',
    ],
    cta: 'Contact Sales',
    ctaHref: 'mailto:hello@serveiq.io',
    highlighted: false,
  },
];
---
<BaseLayout title="Pricing" description={description} canonical={canonical} jsonLd={jsonLd}>

  <section style="padding:4rem 0 2rem; text-align:center;">
    <div class="container">
      <h1 style="font-size:clamp(2rem,4vw,2.8rem);font-weight:800;margin-bottom:0.75rem;">Simple, transparent pricing</h1>
      <p style="font-size:1.1rem;color:var(--brand-gray);max-width:560px;margin:0 auto;">
        No hidden fees. No per-terminal charges. Start free, upgrade when you are ready.
      </p>
    </div>
  </section>

  <section style="padding:2rem 0 4rem;">
    <div class="container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;max-width:980px;">
      {plans.map(plan => (
        <div style={`border:2px solid ${plan.highlighted ? 'var(--brand-orange)' : 'var(--border)'};border-radius:14px;padding:2rem;background:${plan.highlighted ? '#fff7ed' : '#fff'};position:relative;`}>
          {plan.highlighted && (
            <span style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--brand-orange);color:#fff;font-size:0.75rem;font-weight:700;padding:0.25rem 0.9rem;border-radius:99px;white-space:nowrap;">Most Popular</span>
          )}
          <h3 style="font-size:1.2rem;margin-bottom:0.25rem;">{plan.name}</h3>
          <div style="margin:0.75rem 0;">
            <span style="font-size:2.2rem;font-weight:800;">{plan.price}</span>
            <span style="color:var(--brand-gray);font-size:0.9rem;">{plan.period}</span>
          </div>
          <p style="color:var(--brand-gray);font-size:0.9rem;margin-bottom:1.25rem;">{plan.description}</p>
          <ul style="list-style:none;margin-bottom:1.5rem;">
            {plan.features.map(f => (
              <li style="padding:0.3rem 0;font-size:0.9rem;color:var(--brand-dark);">&#10003; {f}</li>
            ))}
          </ul>
          <a href={plan.ctaHref} class="btn-primary" style={`display:block;text-align:center;width:100%;${plan.highlighted ? '' : 'background:var(--brand-dark);'}`}>{plan.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <FAQ />

</BaseLayout>
