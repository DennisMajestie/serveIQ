---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const canonical = 'https://serveiq.io/pricing';
const description = 'Beta pricing for restaurants, bars and hotels — early partners lock in their first-year rate. No setup fees, no per-order cut. Plan for a single location up to multi-branch. Naira, VAT exclusive.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Pricing',
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'ServeIQ', url: 'https://serveiq.io' },
};

const plans = [
  {
    name: 'Starter',
    price: '₦15,000',
    period: '/month',
    description: 'Everything a single location needs to stop leaking revenue.',
    features: [
      'Point of sale & kitchen display',
      'Live floor plan and QR menu',
      'Up to 5 staff PINs',
      'Paystack / transfer payments',
      'Daily sales summary',
    ],
    cta: 'Start free trial',
    ctaHref: 'https://serve-iq-one.vercel.app/register',
    highlighted: false,
  },
  {
    name: 'Growth',
    price: '₦35,000',
    period: '/month',
    description: 'Inventory, tabs and shift control for busy kitchens.',
    features: [
      'Everything in Starter',
      'Recipe-level inventory & suppliers',
      'Open tabs — trusted customer credit',
      'Shifts with cash handoff',
      'Full analytics & staff performance',
      'Up to 20 staff PINs',
    ],
    cta: 'Start free trial',
    ctaHref: 'https://serve-iq-one.vercel.app/register',
    highlighted: true,
  },
  {
    name: 'Multi-branch',
    price: 'Custom',
    period: '',
    description: 'One view across every branch, with enterprise controls.',
    features: [
      'Everything in Growth',
      'Cross-branch dashboard & reports',
      'Device management & audit logs',
      'Unlimited staff PINs',
      'Dedicated onboarding & support',
    ],
    cta: 'Talk to us',
    ctaHref: 'mailto:hello@serveiq.io',
    highlighted: false,
  },
];
---
<BaseLayout title="Pricing" description={description} canonical={canonical} jsonLd={jsonLd}>

  <section style="padding:4rem 0 2rem; text-align:center;">
    <div class="container">
      <h1 style="font-size:clamp(2rem,4vw,2.8rem);font-weight:800;margin-bottom:0.75rem;">Simple plans that grow with your floor</h1>
      <p style="font-size:1.1rem;color:var(--brand-gray);max-width:560px;margin:0 auto;">
        Early partners lock in beta pricing for their first year — no setup fees, no per-order cut. Your money stays yours.
      </p>
    </div>
  </section>

  <section style="padding:2rem 0 4rem;">
    <div class="container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;max-width:980px;">
      {plans.map(plan => (
        <div style={`border:2px solid ${plan.highlighted ? 'var(--brand-orange)' : 'var(--border)'};border-radius:14px;padding:2rem;background:${plan.highlighted ? '#fff7ed' : '#fff'};position:relative;`}>
          {plan.highlighted && (
            <span style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--brand-orange);color:#fff;font-size:0.75rem;font-weight:700;padding:0.25rem 0.9rem;border-radius:99px;white-space:nowrap;">Most Popular</span>
          )}
          <h3 style="font-size:1.2rem;margin-bottom:0.25rem;">{plan.name}</h3>
          <div style="margin:0.75rem 0;">
            <span style="font-size:2.2rem;font-weight:800;">{plan.price}</span>
            <span style="color:var(--brand-gray);font-size:0.9rem;">{plan.period}</span>
          </div>
          <p style="color:var(--brand-gray);font-size:0.9rem;margin-bottom:1.25rem;">{plan.description}</p>
          <ul style="list-style:none;margin-bottom:1.5rem;">
            {plan.features.map(f => (
              <li style="padding:0.3rem 0;font-size:0.9rem;color:var(--brand-dark);">&#10003; {f}</li>
            ))}
          </ul>
          <a href={plan.ctaHref} class="btn-primary" style={`display:block;text-align:center;width:100%;${plan.highlighted ? '' : 'background:var(--brand-dark);'}`}>{plan.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section style="text-align:center;padding-bottom:2rem;">
    <p style="color:var(--brand-gray);font-size:0.9rem;max-width:640px;margin:0 auto;">
      Prices in Naira, VAT exclusive. Need something custom — multiple branches or franchise terms?
      <a href="mailto:hello@serveiq.io">Talk to us</a>.
    </p>
  </section>

  <FAQ />

</BaseLayout>
