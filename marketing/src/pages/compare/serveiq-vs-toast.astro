---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://serveiq.io/compare/serveiq-vs-toast';
const description = 'ServeIQ vs Toast POS — compare per-guest split payments, offline mode, pricing, mobile ordering, and multi-branch features. See why restaurants choose ServeIQ as a Toast alternative for Nigeria and West Africa.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ServeIQ vs Toast POS',
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'ServeIQ', url: 'https://serveiq.io' },
};

const rows = [
  { feature: 'Per-guest split payment by item', serveiq: true, toast: false },
  { feature: 'Offline-first ordering & payment', serveiq: true, toast: false },
  { feature: 'QR code table ordering (no app)', serveiq: true, toast: 'Mobile app only' },
  { feature: 'Guest live order tracking', serveiq: true, toast: false },
  { feature: 'Naira (NGN) + transfer/USSD support', serveiq: true, toast: false },
  { feature: 'Multi-branch from day one', serveiq: true, toast: 'Enterprise only' },
  { feature: 'Kitchen department routing', serveiq: true, toast: 'Add-ons' },
  { feature: 'Ingredient stock tracking', serveiq: true, toast: 'Add-on' },
  { feature: 'Transparent pricing', serveiq: true, toast: false },
  { feature: 'Per-terminal fees', serveiq: false, toast: true },
  { feature: 'Long-term contracts', serveiq: false, toast: 'Often required' },
];
---
<BaseLayout title="ServeIQ vs Toast POS" description={description} canonical={canonical} jsonLd={jsonLd}>

  <section style="padding:5rem 0 3rem; text-align:center;">
    <div class="container">
      <p style="color:var(--brand-orange);font-weight:600;font-size:0.9rem;margin-bottom:0.5rem;">Comparison</p>
      <h1 style="font-size:clamp(2rem,4.5vw,3rem);font-weight:800;max-width:700px;margin:0 auto 1rem;">
        ServeIQ vs Toast POS
      </h1>
      <p style="font-size:1.1rem;color:var(--brand-gray);max-width:600px;margin:0 auto;">
        Toast is a well-known US-based restaurant POS. Here is how ServeIQ compares — especially for restaurants in Nigeria and West Africa.
      </p>
    </div>
  </section>

  <section style="padding:2rem 0 4rem;">
    <div class="container" style="max-width:820px;">
      <div style="border:1px solid var(--border);border-radius:12px;overflow:hidden;">
        <div style="display:grid;grid-template-columns:2fr 1fr 1fr;background:var(--brand-dark);color:#fff;font-weight:600;font-size:0.9rem;">
          <div style="padding:0.9rem 1.25rem;">Feature</div>
          <div style="padding:0.9rem 1.25rem;text-align:center;color:var(--brand-orange);">ServeIQ</div>
          <div style="padding:0.9rem 1.25rem;text-align:center;">Toast</div>
        </div>
        {rows.map((row, i) => (
          <div style={`display:grid;grid-template-columns:2fr 1fr 1fr;background:${i % 2 === 0 ? '#fff' : 'var(--surface)'};font-size:0.9rem;border-top:1px solid var(--border);`}>
            <div style="padding:0.8rem 1.25rem;font-weight:500;">{row.feature}</div>
            <div style="padding:0.8rem 1.25rem;text-align:center;color:{row.serveiq === true ? '#16a34a' : row.serveiq === false ? '#dc2626' : 'var(--brand-dark)'};font-weight:500;">
              {row.serveiq === true ? '&#10003;' : row.serveiq === false ? '&#10007;' : row.serveiq}
            </div>
            <div style="padding:0.8rem 1.25rem;text-align:center;color:{row.toast === true ? '#dc2626' : row.toast === false ? '#16a34a' : 'var(--brand-dark)'};font-weight:500;">
              {row.toast === true ? '&#10007;' : row.toast === false ? '&#10003;' : row.toast}
            </div>
          </div>
        ))}
      </div>

      <div style="margin-top:2.5rem;background:var(--surface);border-radius:12px;padding:2rem;">
        <h2 style="font-size:1.3rem;margin-bottom:0.75rem;">The bottom line</h2>
        <p style="color:var(--brand-gray);font-size:0.95rem;line-height:1.8;">
          Toast is built primarily for the US market. <strong>ServeIQ is purpose-built for restaurants in Nigeria and West Africa</strong> — with native Naira support, bank transfer and USSD payment settlement, offline-first reliability, and per-guest split payments that work at the table without extra hardware. If you need transparent pricing without per-terminal fees or long-term contracts, ServeIQ is the stronger fit.
        </p>
      </div>
    </div>
  </section>

  <section style="padding:3rem 0;text-align:center;">
    <div class="container">
      <h2 style="font-size:1.6rem;margin-bottom:0.75rem;">Try ServeIQ free</h2>
      <a href="/pricing" class="btn-primary" style="font-size:1.05rem;padding:0.8rem 2.5rem;">See Pricing</a>
    </div>
  </section>

</BaseLayout>
