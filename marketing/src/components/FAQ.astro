---
const faqs = [
  {
    question: 'How does ServeIQ split a bill across multiple guests?',
    answer: 'Open a guest\'s bill card and pick exactly which menu items they ate. ServeIQ calculates their share instantly — including proportional service charge and VAT. You can also split by fixed amount, percentage, or assign one guest as the remaining-balance payer. Each guest is charged independently; the tab stays open until every share is settled.',
  },
  {
    question: 'Does ServeIQ work when the Internet goes down?',
    answer: 'Yes. ServeIQ is built for environments with unreliable connectivity. Orders, bills and payments queue on the device and sync automatically with idempotency protection when the connection returns — no orders or payments are lost.',
  },
  {
    question: 'What payment methods does ServeIQ support?',
    answer: 'Cash, card (POS terminal integration), bank transfer, USSD, and Paystack. Split payments are supported across all methods — each guest can pay with a different method.',
  },
  {
    question: 'Can customers order directly from their phone?',
    answer: 'Yes. Table QR codes open a progressive web app where guests browse the menu, place orders, track order status in real time, call a waiter, and view or pay their bill — no app install required.',
  },
  {
    question: 'How much does ServeIQ cost?',
    answer: 'Visit serveiq.io/pricing for current plans. ServeIQ offers transparent pricing with no hidden fees and no per-terminal charges.',
  },
  {
    question: 'Is ServeIQ available in Nigeria?',
    answer: 'Yes. ServeIQ is built with Nigerian and West African businesses in mind. It supports Nigerian Naira (NGN), bank transfers, USSD payments, and works offline on mobile devices.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---
<section id="faq" style="padding:3rem 0;">
  <div class="container" style="max-width:720px;">
    <h2 style="font-size:1.6rem;text-align:center;margin-bottom:2rem;">Frequently asked questions</h2>
    <div style="display:grid;gap:1rem;">
      {faqs.map(f => (
        <details style="border:1px solid var(--border);border-radius:10px;padding:1rem 1.25rem;background:#fff;">
          <summary style="font-weight:600;font-size:0.95rem;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
            {f.question}
            <span style="color:var(--brand-orange);font-size:1.2rem;margin-left:0.5rem;">+</span>
          </summary>
          <p style="margin-top:0.75rem;color:var(--brand-gray);font-size:0.95rem;line-height:1.7;">{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
